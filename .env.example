# Redis connection (docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# Cache behavior (ADR-0004 §4.13)
CACHE_SCHEMA_VERSION=v1
# Provisional until benchmarks/threshold_sweep.py runs (ADR-0004 §7)
CACHE_SIMILARITY_THRESHOLD=0.94
CACHE_TTL_SECONDS=604800
CACHE_LOOKUP_TIMEOUT_MS=50
CACHE_ALLOW_TOOLS=true
CACHE_DEBUG_HEADERS=false
